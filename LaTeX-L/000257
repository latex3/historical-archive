%  *  a few changes in wording.

\documentstyle[11pt]{article}

\newcommand{\AmSTeX}
    {$\cal A$\kern-.1667em\lower.5ex\hbox{$\cal M$}\kern-.125em$\cal =
S$-\TeX}
\newcommand{\itlatex}%
    {L\kern-.30em\raise.3ex\hbox{\footnotesize\it A}\kern-.15em
