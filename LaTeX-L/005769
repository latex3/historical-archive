   \else            \in@true
   \fi}
 \in@@#2\@nil#1\in@@}
% Uwe: 
\newcommand*{\in@uwe}[2]{%
 \def\in@@##1#1##2\in@@{%
  \ifx\in@@##2\in@@\in@false\else\in@true\fi}%
 \in@@#2\in@#1\in@@}

