  <blockquote type="cite">
    <pre wrap="">\begingroup
\catcode`\:=13
\catcode`\.=13\relax
\gdef\chemin#1{%
\begingroup
\catcode`\:=13
\catcode`\.=13\relax
\let.\cheminsommet
\let:\cheminface
\endlinechar=-1
\everyeof{}%
\scantokens{#1}%
\endgroup
}
\endgroup
    </pre>
