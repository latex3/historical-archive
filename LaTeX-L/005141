\prg_whiledo:nT {
  \tlp_set:Nx \a_tlp {
    \predicate_p:n {
      \int_compare_p:nNn \a_int < 4 &&
      \c_true % some complex tests here
    }
  }
  \exp_after:NN \tlp_if_eq:NNT \a_tlp
}{
  \io_put_term:x{Loop~ \int_use:N \a_int}
  \int_incr:N \a_int
}

\stop


