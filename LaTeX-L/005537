%
%    During the development of the \LaTeX3 kernel we need to be able
%    to keep track of the memory usage. Therefor we generate empty
%    pages while loading the kernel code, just to be able to check the
%    memory usage.
%
%    \begin{macrocode}
%<*showmemory>
\g_trace_statistics_status=2\scan_stop:
\def:Npn\showMemUsage{
   \if_hmode:
      \err_message:D{Wrong~ mode~ H:~ something~ triggered~ 
                     hmode~ above}
   \else:
      \message:D{Mode ~ okay}
   \fi:
   \page_shipout:D\hbox:w{}
 }
\showMemUsage
%</showmemory>
%    \end{macrocode}



