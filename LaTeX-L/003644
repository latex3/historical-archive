    <|object_constructor.declaration|>
    virtual root* clone() const { <|clone_method_definition|> }
    <|copy_method|>
    <|object_data|>
    virtual Synergy::data method_constructor(Synergy::data&) { return
Synergy::global_<|class_name:cpp|>; }
