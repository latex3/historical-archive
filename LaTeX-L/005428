depends on how efficient you want to make it ...


\def_new:Npn \tlp_reverse:N #1 {
  \tlp_set:Nx #1
    {\tlist_reverse:o{#1}}
}

\def_new:Npn \tlist_reverse:o { \exp_args:No \tlist_reverse:n }

