\begin{document}

\title{A parskip scheme}
\author{Victor Eijkhout}
\address{Department of Mathematics\\
        University of Nijmegen\\
        Toernooiveld 1\\
        6525 ED Nijmegen, The Netherlands}
\netaddress[\network{Bitnet}]{u641001@HNYKUN11}
