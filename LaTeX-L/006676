\input docstrip.tex
\askforoverwritefalse
\preamble
\endpreamble
\postamble
\endpostamble
\keepsilent
\generate{\file{seq-one-braces.sty}{\from{seq-one-braces.dtx}{package,trace}}}
\endbatchfile

