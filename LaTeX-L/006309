+      \toks8{Babel <#3> }%
+    \fi%
     \let\ProvidesFile\@undefined
     }
   \def\ProvidesLanguage#1[#2 #3 #4]{%
@@ -57,7 +61,11 @@
 \else
   \let\bbl@tempa\ProvidesFile
